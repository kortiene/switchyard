{
  "name": "@switchyard/pi-package-audit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "audit:package": "node --experimental-strip-types src/feasibility.ts",
    "gate": "node --experimental-strip-types src/feasibility.ts --gate",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@earendil-works/pi-durable": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/chord": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  }
}
